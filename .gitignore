# Файлы-замки: дозапись архива и сравнений идёт под межпроцессной
# блокировкой, замок живёт отдельным файлом рядом.
*.json.lock
# Матрицы под чужие наборы точек: считаются по надобности,
# в репозитории лежит только основной пул.
vrptw/data/points-*.json
vrptw/data/matrix-*.npz

# Интерфейс.
node_modules/
app/dist/
# Сборка интерфейса лежит в web/ и КОММИТИТСЯ (с 22 сентября): проверяющий
# открывает http://localhost:8000 без node и без сборки. Кладёт её
# `zsh собрать-интерфейс.sh` из ветки «движок» репозитория Антона.
# Прежняя страница проверки соединения (11 сентября) отложена сюда:
.старый-web-11-09/

# Кэш инкрементальной сборки TypeScript.
*.tsbuildinfo

# Каталог для переноса в новое окно: копии того, что уже есть в репозитории.
передача/

# Копия вёрстки Антона, соединённая с движком. В репозиторий не идёт: это
# 43 МБ чужого дерева, и хранить его форком незачем. Сама правка лежит
# рядом файлом `соединение-с-движком.patch` — он и есть то, что нужно
# сохранить и что можно показать автору вёрстки.
вёрстка-на-движке/
